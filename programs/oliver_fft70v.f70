C     TRI-TRAN 70V SHOWCASE 3: OLIVER-GOOD RADIX-3 TBFP-9C FFT ON T-FABRIC
C     SYNTHESIZES A 27-POINT (3**3) COMPLEX CARRIER AT BIN 9 IN EXACT TF36,
C     PACKS 2 TBFP-9C COMPLEX SAMPLES PER T36 WORD, DISPATCHES CALL TFFT3
C     ACROSS ALL 27 ACTIVE T-TILES, AND LOCATES THE PEAK BIN IN FORTRAN!
      PROGRAM OLVFFT
      INTEGER XIN(14), XOUT(14), K, WIDX, ISTAT, IPEAK
      INTEGER R0, I0, R1, I1, REB, IMB, PWR, MAXPWR
      REAL ANG0, ANG1, TWOPI
      TWOPI = 6.283185307179586
C     PACK 27 COMPLEX SAMPLES (BIN 9 OF 27: FREQ = 9/27 = 1/3 CYCLE/SAMPLE)
      DO 10 WIDX = 1, 14
        K = (WIDX - 1) * 2
        ANG0 = TWOPI * 9.0 * FLOAT(K) / 27.0
        R0 = NINT(800.0 * COS(ANG0))
        I0 = NINT(800.0 * SIN(ANG0))
        IF (K + 1 .LT. 27) GO TO 12
        R1 = 0
        I1 = 0
        GO TO 14
   12   ANG1 = TWOPI * 9.0 * FLOAT(K + 1) / 27.0
        R1 = NINT(800.0 * COS(ANG1))
        I1 = NINT(800.0 * SIN(ANG1))
   14   XIN(WIDX) = ((R0 * 19683 + I0) * 19683 + R1) * 19683 + I1
   10 CONTINUE
C     DISPATCH RADIX-3 TBFP-9C FFT (N = 3**3 = 27, E_IN = 8) TO ALL 27 T-TILES!
      CALL TFFT3(XIN, XOUT, 3, 8, ISTAT)
C     SCAN UNPACKED SPECTRAL BINS 0..26 FOR PEAK POWER
      MAXPWR = -1
      IPEAK = -1
      DO 20 K = 0, 26
        WIDX = (K / 2) + 1
        IF (MOD(K, 2) .EQ. 0) GO TO 22
        REB = IXTR(XOUT(WIDX), 9, 9)
        IMB = IXTR(XOUT(WIDX), 0, 9)
        GO TO 24
   22   REB = IXTR(XOUT(WIDX), 27, 9)
        IMB = IXTR(XOUT(WIDX), 18, 9)
   24   PWR = REB * REB + IMB * IMB
        IF (PWR .LE. MAXPWR) GO TO 20
        MAXPWR = PWR
        IPEAK = K
   20 CONTINUE
      WRITE (6, 100) IPEAK, MAXPWR, ISTAT
  100 FORMAT (1X, 'RADIX-3 FFT PEAK BIN=', I3, ' PWR=', I10,
     +        ' STAT=', I2)
C     3-WAY ARITHMETIC IF ON HARDWARE STATUS TRIT (-1 CUTOVER, 0 TIMEOUT, +1 OK)
      IF (ISTAT) 90, 91, 92
   90 STOP 200
   91 STOP 999
   92 STOP 9
      END
