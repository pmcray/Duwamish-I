-- SAL-3 Showcase 2: Vectorized TF36 Cliodynamics & UNDECIDED Float Safety
-- Demonstrates C-Complex hardware vector strip-mining (VL <= 27 over 36 regions!),
-- single-round TF36 VFMA, hardware VRED sum reduction, and Rev. 1.5 FCM safety
-- on `undecided_f` (NaN).

bloop

global pop   : FLOAT[36]
global rate  : FLOAT[36]
global dt    : FLOAT[36]

proc classify_float(x : FLOAT) -> TRIT
begin
  -- SAL-3 emits FCM S1, S0 here (NOT raw TST), so undecided_f cleanly hits `zero`!
  sign x of
    - : return false
    0 : return undecided
    + : return true
  end
end

proc main() -> INT
begin
  var i : INT := 0
  for i := 0 to 35 do
  begin
    pop[i]  := 1.0
    rate[i] := 0.05
    dt[i]   := 2.0
  end

  -- Hardware C-Complex strip-mined VFMA across 36 regions (chunks of 27 + 9!):
  -- pop[0..35] := pop[0..35] + rate[0..35] * dt[0..35]  -> 1.0 + 0.05 * 2.0 = 1.10
  pop[0..35] := fma(rate[0..35], dt[0..35])
  -- Second step: 1.10 + 0.10 = 1.20
  pop[0..35] := fma(rate[0..35], dt[0..35])

  -- Hardware VRED sum of first 27 regions (27 * 1.20 = 32.40)
  var sum27 : FLOAT := vsum(pop, 27)
  var check_nan : TRIT := classify_float(undecided_f)
  var check_pos : TRIT := classify_float(sum27)

  print_float(sum27)
  print_trit(check_nan)
  print_trit(check_pos)

  -- Return rounded sum27 (32) if NaN classification held UNDECIDED (0)
  if check_nan = undecided then
    return fix(sum27)
  return -999
end
