* FORRESTER SUPPLY-CHAIN & INFORMATION-DELAY OSCILLATOR (DYNAMO-X)
* Demonstrates SMOOTH (1st-order) and DELAY3 (3rd-order Erlang) macro expansion
* producing classic MIT Industrial Dynamics (1961) inventory overshoot!

SPEC DT=0.5, LENGTH=40.0, TSTART=0.0, PRTPER=5.0, PLTPER=2.0, METHOD=RK2

C DEMAND_BASE = 100.0
C SHOCK_SIZE  = 25.0
C ADJ_TIME    = 3.0
C PROD_DELAY  = 4.5
C SMOOTH_TIME = 2.0

N INV = 400.0

A ORDERS.K   = DEMAND_BASE + STEP(SHOCK_SIZE, 5.0)
A FORECAST.K = SMOOTH(ORDERS.K, SMOOTH_TIME)
A DES_INV.K  = 4.0 * FORECAST.K
R PROD_ST.KL = MAX(0.0, FORECAST.K + (DES_INV.K - INV.K) / ADJ_TIME)
A ARRIVALS.K = DELAY3(PROD_ST.KL, PROD_DELAY)

L INV.K = INV.J + DT * (ARRIVALS.K - ORDERS.K)

ASHBY INV IN [300.0, 560.0]

PRINT ORDERS, FORECAST, ARRIVALS, INV
PLOT  ORDERS=O, ARRIVALS=A, INV=I
